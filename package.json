{
  "name": "hud-recorder",
  "version": "0.5.0",
  "description": "Video log recorder for Windows, macOS and Linux that burns a sci-fi style HUD overlay into the recording.",
  "main": "src/main/main.js",
  "author": "seamys",
  "license": "MIT",
  "homepage": "https://seamys.github.io/hud-recorder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seamys/hud-recorder.git"
  },
  "bugs": {
    "url": "https://github.com/seamys/hud-recorder/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "screen-recorder",
    "video-log",
    "vlog",
    "hud",
    "overlay",
    "telemetry"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@mediapipe/tasks-vision": "^0.10.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.seamys.hudrecorder",
    "productName": "HUD Recorder",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "HUD Recorder records video from your camera.",
        "NSMicrophoneUsageDescription": "HUD Recorder records audio from your microphone."
      }
    },
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  }
}
